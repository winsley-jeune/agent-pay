{
  "name": "agent-pay",
  "version": "1.0.0",
  "description": "Open-source control panel for AI agents' spending: prepaid wallet, levels and rules, envelopes, passkey approvals, kill switch and a tamper-evident log, over MCP",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "mcp": "tsx packages/mcp/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:maria": "tsx src/seed-maria.ts",
    "build:mcp": "npm run build -w packages/mcp",
    "build:verify": "npm run build -w packages/verify"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "agent-payments",
    "agentic-commerce",
    "spending-controls",
    "passkeys",
    "webauthn",
    "double-entry-ledger",
    "subscriptions",
    "claude"
  ],
  "homepage": "https://github.com/winsley-jeune/agent-pay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winsley-jeune/agent-pay.git"
  },
  "bugs": "https://github.com/winsley-jeune/agent-pay/issues",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "stripe": "^23.0.1",
    "viem": "^2.57.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
