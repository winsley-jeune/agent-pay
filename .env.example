# Postgres (docker compose exposes it on 5433)
DATABASE_URL=postgres://agentpay:agentpay@localhost:5433/agentpay

# HTTP server
PORT=8787
PUBLIC_URL=http://localhost:8787

# Stripe TEST-mode keys only (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:8787/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...

# Platform cut of every paid call, in basis points (1000 = 10%)
PLATFORM_FEE_BPS=1000

# Lets the dashboard add free test credits without Stripe. Never enable in production.
ALLOW_DEV_CREDIT=true

# Reads photos of grocery lists (https://console.anthropic.com). Optional; typed lists work without it.
ANTHROPIC_API_KEY=

# Optional: automatic Amazon prices for price watches (https://keepa.com/#!api)
KEEPA_API_KEY=
